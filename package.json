{
  "name": "airlock",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "app:dev": "pnpm --filter @airlock/desktop app:dev",
    "app:dev:cpu": "pnpm --filter @airlock/desktop app:dev:cpu",
    "app:build": "pnpm --filter @airlock/desktop app:build",
    "app:build:cpu": "pnpm --filter @airlock/desktop app:build:cpu",
    "app:check": "pnpm --filter @airlock/desktop app:check",
    "app:test": "pnpm --filter @airlock/desktop app:test",
    "web:dev": "pnpm --filter @airlock/web dev",
    "web:build": "pnpm --filter @airlock/web build",
    "web:preview": "pnpm --filter @airlock/web preview",
    "web:deploy": "pnpm --filter @airlock/web deploy",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "clean": "pnpm --filter @airlock/desktop clean",
    "version:set": "node scripts/set-version.mjs",
    "ui:relativize": "pnpm --filter @airlock/desktop ui:relativize"
  }
}
