{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "airlock",
	"compatibility_date": "2025-09-01",
	// SvelteKit's server bundle reaches for node: builtins even when the routes do not.
	"compatibility_flags": ["nodejs_compat"],
	// No `main` or `assets` here: adapter-cloudflare sets the Worker entry and the static assets
	// itself, and refuses to build when they are present.
	"observability": { "enabled": true },
	"routes": [
		{
			"pattern": "airlock.nexonauts.com",
			"custom_domain": true
		}
	]
}
