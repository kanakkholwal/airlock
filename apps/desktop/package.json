{
  "name": "@airlock/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev --port 1420 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "app:dev": "tauri dev --features vulkan",
    "app:build": "tauri build --features vulkan",
    "app:check": "cargo check --manifest-path src-tauri/Cargo.toml --features vulkan",
    "icons": "node scripts/gen-icons.mjs",
    "audit": "pnpm audit",
    "clean": "node scripts/clean.mjs",
    "app:dev:cpu": "tauri dev",
    "app:build:cpu": "tauri build",
    "app:test": "cargo test --manifest-path src-tauri/Cargo.toml --features vulkan",
    "test": "vitest run",
    "ui:relativize": "node scripts/relativize-imports.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.1.16",
    "@tauri-apps/cli": "^2.12.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@docvia/markdown": "^3.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@solar-icons/svelte": "^2.6.1",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "bits-ui": "^2.21.0",
    "clsx": "^2.1.1",
    "svelte-sonner": "^1.2.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.2",
    "tauri-plugin-macos-permissions-api": "^2.3.0",
    "vaul-svelte": "1.0.0-next.7"
  }
}
